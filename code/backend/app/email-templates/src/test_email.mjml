<mjml>
  <mj-head>
    <mj-preview>Test email from {{ project_name }} was delivered successfully.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-body width="640px" />
      <mj-text padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#020617">
    <mj-section background-color="#0f172a" border="1px solid rgba(96,165,250,0.32)" border-radius="16px 16px 0 0" padding="28px 28px 18px">
      <mj-column>
        <mj-text color="#22d3ee" font-size="12px" font-weight="700" letter-spacing="3px" text-transform="uppercase">Email test</mj-text>
        <mj-text color="#ffffff" font-size="28px" line-height="1.2" padding-top="12px">{{ project_name }} email is working</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#070b1d" border-left="1px solid rgba(96,165,250,0.32)" border-right="1px solid rgba(96,165,250,0.32)" padding="30px 28px">
      <mj-column>
        <mj-text color="#cbd5e1" font-size="16px" line-height="1.7" padding-bottom="16px">Hello,</mj-text>
        <mj-text color="#cbd5e1" font-size="16px" line-height="1.7" padding-bottom="24px">This is a test message from {{ project_name }}. If you can see this email, the backend SMTP configuration is connected correctly.</mj-text>
        <mj-text color="#cbd5e1" font-size="16px" line-height="1.7" padding-bottom="24px">
          Bonus diagnostics: <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" style="color:#67e8f9;font-weight:800;text-decoration:none;">Click here to complete the test</a>.
        </mj-text>
        <mj-text color="#94a3b8" font-size="14px" line-height="1.7">You can now use the same SMTP path for password recovery, account creation, and verification emails during local development.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#050816" border="1px solid rgba(96,165,250,0.18)" border-radius="0 0 16px 16px" padding="18px 28px">
      <mj-column>
        <mj-text color="#64748b" font-size="12px">{{ project_name }} secure identity and trading access</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
